{
  "manifest_version": 3,
  "name": "Baseball Break Muter",
  "version": "0.1.10",
  "description": "Locally detects commercial-break player states and can mute the browser tab while commercials continue playing.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.mlb.com/tv/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Baseball Break Muter",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mlb.com/tv/*"
      ],
      "js": [
        "src/detector.js",
        "src/overlay-policy.js",
        "src/timing-policy.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
