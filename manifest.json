{
  "manifest_version": 3,
  "name": "Ad Muter for MLB.TV",
  "version": "0.1.10",
  "description": "Locally detects commercial-break player states and can mute the browser tab while commercials continue playing.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.mlb.com/tv/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    },
    "default_title": "Ad Muter for MLB.TV",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mlb.com/tv/*"
      ],
      "js": [
        "src/detector.js",
        "src/overlay-policy.js",
        "src/timing-policy.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
