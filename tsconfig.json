{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ES2022",
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "types": [
      "chrome-types"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts"
  ]
}
