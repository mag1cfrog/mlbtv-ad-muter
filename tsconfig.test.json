{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "DOM"
    ],
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "types": [
      "chrome-types",
      "node"
    ]
  },
  "include": [
    "src/types.d.ts",
    "test/**/*.ts"
  ]
}
